{
  "name": "gui-st",
  "version": "1.3.1",
  "description": "gui-st — личная игровая библиотека для Windows",
  "main": "main.js",
  "author": "GameVault",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gamevault.app",
    "productName": "gui-st",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "gui-st-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "gui-st-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yzemu",
        "repo": "gui-st"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}